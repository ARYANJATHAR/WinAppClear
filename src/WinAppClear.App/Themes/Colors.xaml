<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="AccentColor">#10A37F</Color>
    <Color x:Key="AccentDarkColor">#0B8466</Color>
    <Color x:Key="AccentSoftColor">#E3F5EF</Color>
    <Color x:Key="DangerColor">#D64545</Color>
    <Color x:Key="DangerSoftColor">#FCE8E8</Color>
    <Color x:Key="WarningColor">#C9831C</Color>
    <Color x:Key="WarningSoftColor">#FDF1DE</Color>
    <Color x:Key="InfoColor">#3D7BD9</Color>
    <Color x:Key="InfoSoftColor">#E5EEFB</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />

    <SolidColorBrush x:Key="WindowBrush" Color="#F3F5F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFB" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF2F5" />
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#E7F6F1" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E7ED" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD3DC" />

    <SolidColorBrush x:Key="TextBrush" Color="#18212E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6676" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A95A3" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SidebarBrush" Color="#0E1A2B" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#16263C" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1C3150" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#C5D0DE" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#6F8098" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
