<UserControl x:Class="WinAppClear.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:health="clr-namespace:WinAppClear.Core.Health;assembly=WinAppClear.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Uninstalling" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <CheckBox Content="Create a System Restore point before uninstalling" IsChecked="{Binding CreateRestorePoint}" Margin="0,0,0,8" />
                    <CheckBox Content="Use quiet (silent) uninstall by default when available" IsChecked="{Binding QuietUninstallByDefault}" Margin="0,0,0,8" />
                    <CheckBox Content="Pre-select only High-confidence leftovers (recommended)" IsChecked="{Binding PreselectOnlyHighConfidence}" Margin="0,0,0,8" />
                    <CheckBox Content="Show system components and runtimes in the Programs list" IsChecked="{Binding ShowSystemComponents}" />
                    <TextBlock Text="Takes effect the next time the Programs list is refreshed." Style="{StaticResource Small}" Margin="22,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Backups" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Keep backups for" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding BackupRetentionDays}" Width="90" />
                        <TextBlock Text="days  (0 = keep forever)" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource Muted}" />
                        <Button Content="Clean up old backups now" Command="{Binding PruneBackupsCommand}" Margin="16,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Unwanted-software list" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="Software Health flags programs and extensions that match a built-in list of known adware and PUPs. Add your own names to extend it." />
                    <Button Content="Edit my list" Command="{Binding EditBlocklistCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding SwitchedOff.Count, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="Things you've switched off" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding SwitchedOff}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type health:ToggleItem}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Small}">
                                            <Run Text="{Binding Owner, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding KindLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Switch back on" VerticalAlignment="Center"
                                            Command="{Binding DataContext.ReenableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                        <Run Text="WinAppClear keeps its backups, history, install logs and logs in:" />
                        <LineBreak />
                        <Run Text="{Binding DataFolder, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="Open logs" Command="{Binding OpenLogsCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Small}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="WinAppClear never deletes Windows files, other users' data or anything another installed program still uses. Every removal is backed up first." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
