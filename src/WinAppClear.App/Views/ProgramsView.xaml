<UserControl x:Class="WinAppClear.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="ProgramSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6"
                         AutomationProperties.Name="Search programs or publishers" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="10,0,0,0" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" />
                <TextBlock Text="Search programs or publishers" Margin="31,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                           IsHitTestVisible="False" Visibility="{Binding Search, Converter={StaticResource NotVis}}" />
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Command="{Binding ClearSelectionCommand}" Margin="0,0,6,0"
                        Visibility="{Binding SelectedCount, Converter={StaticResource Vis}}" Content="Clear selection" />
                <Button Command="{Binding RefreshCommand}" Margin="0,0,8,0" ToolTip="Reload the list">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DangerButton}" Command="{Binding UninstallCommand}" CommandParameter="{x:Null}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Uninstall" />
                        <TextBlock Margin="4,0,0,0" Visibility="{Binding SelectedCount, Converter={StaticResource Vis}}">
                            <Run Text="(" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="Grid" Grid.Row="1" ItemsSource="{Binding View}" SelectedItem="{Binding SelectedRow}" SelectionMode="Single"
                  RowHeight="52" CanUserSortColumns="True">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding UninstallCommand}" CommandParameter="{Binding SelectedRow}" />
                <KeyBinding Key="Delete" Command="{Binding UninstallCommand}" CommandParameter="{Binding SelectedRow}" />
            </DataGrid.InputBindings>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Uninstall" Command="{Binding UninstallCommand}" CommandParameter="{Binding SelectedRow}" />
                    <MenuItem Header="Repair / Modify" Command="{Binding RepairCommand}" CommandParameter="{Binding SelectedRow}" />
                    <MenuItem Header="Hibernate / Wake" Command="{Binding HibernateCommand}" CommandParameter="{Binding SelectedRow}" />
                    <Separator />
                    <MenuItem Header="Open install folder" Command="{Binding OpenLocationCommand}" CommandParameter="{Binding SelectedRow}" />
                    <MenuItem Header="Open in Registry Editor" Command="{Binding OpenRegistryCommand}" CommandParameter="{Binding SelectedRow}" />
                    <MenuItem Header="Search online" Command="{Binding SearchOnlineCommand}" CommandParameter="{Binding SelectedRow}" />
                    <MenuItem Header="Copy name" Command="{Binding CopyNameCommand}" CommandParameter="{Binding SelectedRow}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource HoverBrush}" HorizontalAlignment="Left">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource InfoSoftBrush}" Margin="8,0,0,0" Padding="6,0"
                                                Visibility="{Binding IsHibernated, Converter={StaticResource Vis}}">
                                            <TextBlock Text="Sleeping" FontSize="10.5" Foreground="{StaticResource InfoBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource WarningSoftBrush}" Margin="0,1,6,0" Padding="6,0"
                                                Visibility="{Binding GroupLabel, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding GroupLabel}" FontSize="10.5" Foreground="{StaticResource WarningBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Publisher}" Style="{StaticResource Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Size" Width="90" SortMemberPath="Size">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Size, Converter={StaticResource Size}}" Style="{StaticResource CellMuted}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Installed" Width="100" SortMemberPath="InstallDate">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding InstallDate, Converter={StaticResource Date}}" Style="{StaticResource CellMuted}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Last used" Width="110" SortMemberPath="LastUsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LastUsed, Converter={StaticResource RelDate}, ConverterParameter=—}" Style="{StaticResource CellMuted}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Version" Width="120" SortMemberPath="Version">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Version}" Style="{StaticResource CellMuted}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Type" Width="70" SortMemberPath="Architecture">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Architecture}" Style="{StaticResource CellMuted}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GhostButton}" ToolTip="Uninstall"
                                    Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource DangerBrush}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding EmptyText, Converter={StaticResource Vis}}" Margin="0,40,0,0" />
    </Grid>
</UserControl>
