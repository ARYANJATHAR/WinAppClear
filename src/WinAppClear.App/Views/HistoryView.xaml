<UserControl x:Class="WinAppClear.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinAppClear.App.ViewModels"
             xmlns:hist="clr-namespace:WinAppClear.Core.History;assembly=WinAppClear.Core"
             xmlns:models="clr-namespace:WinAppClear.Core.Models;assembly=WinAppClear.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,14,16,8">
                        <TextBlock Text="Uninstall history" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Clear history" Command="{Binding ClearHistoryCommand}" />
                        </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" SelectionMode="Single" BorderThickness="0,1,0,0"
                              IsReadOnly="True" RowHeight="46">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Program" Width="*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type hist:HistoryEntry}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Result}" Style="{StaticResource Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="When" Width="140" SortMemberPath="Date">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Date, Converter={StaticResource Date}, ConverterParameter=time}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="How" Width="110" SortMemberPath="Method">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Method}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Leftovers" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellMuted}">
                                            <Run Text="{Binding LeftoversRemoved, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding LeftoversFound, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Freed" Width="90" SortMemberPath="BytesFreed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BytesFreed, Converter={StaticResource Size}}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Kept or not removed" Style="{StaticResource SectionTitle}" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Small}" Margin="0,2,0,8"
                               Text="Leftovers you chose to keep. Software Health re-checks these and offers them again." />
                    <ListBox ItemsSource="{Binding SelectedRemaining}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LeftoverItem}">
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayPath}" MaxWidth="300" />
                                    <TextBlock Style="{StaticResource Small}">
                                        <Run Text="{Binding KindLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Confidence, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                    <TextBlock Text="Backups" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Everything WinAppClear removed is kept here so you can put it back. Old backups are cleaned up automatically (see Settings)."
                               Style="{StaticResource Small}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Backups}" SelectionMode="Single" BorderThickness="0,1,0,0" IsReadOnly="True" RowHeight="46">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Backup" Width="*" SortMemberPath="Title">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:BackupRow}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding State}" Style="{StaticResource Small}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Created" Width="150" SortMemberPath="Created">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Created, Converter={StaticResource Date}, ConverterParameter=time}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Size" Width="90" SortMemberPath="Size">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Size, Converter={StaticResource Size}}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="270">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Restore" Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Open folder" Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.OpenBackupFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Delete" Style="{StaticResource GhostButton}" Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
