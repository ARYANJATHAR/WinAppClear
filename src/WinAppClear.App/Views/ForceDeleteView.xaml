<UserControl x:Class="WinAppClear.App.Views.ForceDeleteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinAppClear.App.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Background="{StaticResource SurfaceBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Add files…" Command="{Binding AddFilesCommand}" Margin="0,0,8,0" />
                    <Button Content="Add folder…" Command="{Binding AddFolderCommand}" Margin="0,0,8,0" />
                    <Button Content="What's using them?" Command="{Binding FindLockersCommand}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <CheckBox Content="Close programs that are using these files" IsChecked="{Binding CloseLockingPrograms}" Margin="0,0,0,6" />
                    <CheckBox Content="Move to the Recycle Bin instead of deleting permanently" IsChecked="{Binding UseRecycleBin}" Margin="0,0,0,12" />
                    <Button Content="Force delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" HorizontalAlignment="Left" />
                </StackPanel>
                <Grid>
                    <TextBlock Text="Drop files or folders here" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Paths.Count, Converter={StaticResource NotVis}}" />
                    <ListBox ItemsSource="{Binding Paths}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}" />
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" ToolTip="Remove from list"
                                            Command="{Binding DataContext.RemovePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0">
            <Border Style="{StaticResource Card}" Visibility="{Binding Lockers.Count, Converter={StaticResource Vis}}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="In use by" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Lockers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Small}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding Results.Count, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="Results" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PathResult}">
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    <TextBlock Text="{Binding Result}" FontSize="12" TextWrapping="Wrap" Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
