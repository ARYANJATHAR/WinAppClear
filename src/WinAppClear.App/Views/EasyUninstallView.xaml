<UserControl x:Class="WinAppClear.App.Views.EasyUninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Drag this target onto a program's window" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <Border x:Name="Target" Width="140" Height="140" CornerRadius="70" Background="{StaticResource AccentSoftBrush}" Cursor="Cross"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                        MouseLeftButtonDown="Target_MouseLeftButtonDown" MouseLeftButtonUp="Target_MouseLeftButtonUp">
                    <TextBlock x:Name="TargetGlyph" Text="&#xE7C9;" Style="{StaticResource Icon}" FontSize="56" HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentDarkBrush}" />
                </Border>
                <TextBlock Text="Press, hold, move over a window, release." Style="{StaticResource Small}" HorizontalAlignment="Center" Margin="0,14,0,18" />
                <TextBlock Text="…or choose an open window" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" Width="270" />
                <Button Style="{StaticResource GhostButton}" Content="Refresh window list" Command="{Binding RefreshWindowsCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="13.5" Visibility="{Binding Message, Converter={StaticResource Vis}}" />
                <StackPanel Visibility="{Binding Match, Converter={StaticResource Vis}}">
                    <TextBlock Text="Found it" Style="{StaticResource Small}" />
                    <TextBlock Text="{Binding Match.DisplayName}" Style="{StaticResource PageTitle}" FontSize="22" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                        <Run Text="{Binding Match.Publisher, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Match.DisplayVersion, Mode=OneWay}" />
                    </TextBlock>
                    <Button Content="Uninstall this program" Style="{StaticResource DangerButton}" Command="{Binding UninstallCommand}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
                <StackPanel Margin="0,16,0,0" Visibility="{Binding TargetPath, Converter={StaticResource Vis}}">
                    <TextBlock Text="Program file" Style="{StaticResource Small}" />
                    <TextBlock Text="{Binding TargetPath}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                    <Button Style="{StaticResource GhostButton}" Content="Force uninstall its folder instead" Command="{Binding ForceUninstallFolderCommand}"
                            HorizontalAlignment="Left" Padding="0,8" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
