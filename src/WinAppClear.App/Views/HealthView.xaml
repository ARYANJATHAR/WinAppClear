<UserControl x:Class="WinAppClear.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinAppClear.App.ViewModels"
             xmlns:health="clr-namespace:WinAppClear.Core.Health;assembly=WinAppClear.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <!-- Status headline -->
            <Border Style="{StaticResource Card}" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="26" Background="{Binding HeadlineTone, Converter={StaticResource SoftTone}}">
                        <TextBlock Text="&#xE95E;" Style="{StaticResource Icon}" FontSize="24" HorizontalAlignment="Center"
                                   Foreground="{Binding HeadlineTone, Converter={StaticResource Tone}}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource SectionTitle}" FontSize="18" />
                        <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Padding="22,9"
                            IsEnabled="{Binding Scanning, Converter={StaticResource Not}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" Foreground="White" />
                            <TextBlock Text="Scan now" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Nine checks -->
            <ItemsControl ItemsSource="{Binding Categories}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HealthCategoryViewModel}">
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="18,14" Cursor="Hand" Background="Transparent">
                                    <Grid.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}" />
                                    </Grid.InputBindings>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="9" Background="{Binding Tone, Converter={StaticResource SoftTone}}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="17" HorizontalAlignment="Center"
                                                   Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True" Width="60" Margin="0,0,10,0" Visibility="{Binding IsWorking, Converter={StaticResource Vis}}" />
                                        <Border Style="{StaticResource Pill}" Background="{Binding Tone, Converter={StaticResource SoftTone}}">
                                            <TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Style="{StaticResource Icon}" FontSize="12" Margin="14,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                                               Visibility="{Binding HasIssues, Converter={StaticResource Vis}}">
                                        <TextBlock.Text>&#xE70D;</TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <!-- Expanded issue list -->
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10,18,14">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{x:Static vm:Converters.AllTrueToVisibility}">
                                            <Binding Path="IsExpanded" />
                                            <Binding Path="HasIssues" />
                                        </MultiBinding>
                                    </Border.Visibility>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Visibility="{Binding Error, Converter={StaticResource Vis}}" />
                                        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Issues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:HealthIssueRow}">
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanFix}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding Size, Converter={StaticResource Size}}" Style="{StaticResource Muted}" Margin="12,0,0,0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button Style="{StaticResource GhostButton}" Content="Select all" Command="{Binding SelectAllCommand}" />
                                            <Button Style="{StaticResource GhostButton}" Content="Select none" Command="{Binding SelectNoneCommand}" Margin="0,0,10,0" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding FixLabel}" Command="{Binding FixCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sleeping programs -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,10" Visibility="{Binding Hibernated.Count, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="Sleeping programs" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="These programs are hibernated: their background services, tasks and startup entries are switched off." Style="{StaticResource Small}" Margin="0,2,0,8" />
                    <ItemsControl ItemsSource="{Binding Hibernated}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type health:HibernationRecord}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding ProgramName, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Items.Count, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Run Text="item(s) asleep since" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Run Text="{Binding Date, Mode=OneWay, StringFormat=d}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </TextBlock>
                                    <Button Grid.Column="1" Content="Wake up" Command="{Binding DataContext.WakeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Switched-off items -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="{Binding SwitchedOff.Count, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="Things you've switched off" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Permissions and notifications you turned off with WinAppClear. Switch any of them back on here." Style="{StaticResource Small}" Margin="0,2,0,8" />
                    <ItemsControl ItemsSource="{Binding SwitchedOff}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type health:ToggleItem}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Small}">
                                            <Run Text="{Binding Owner, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding KindLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Switch back on" Command="{Binding DataContext.ReenableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
