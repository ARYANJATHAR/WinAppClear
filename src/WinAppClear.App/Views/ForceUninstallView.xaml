<UserControl x:Class="WinAppClear.App.Views.ForceUninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WinAppClear.Core.Models;assembly=WinAppClear.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Remove a program by its folder" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Small}" Margin="0,2,0,12"
                               Text="Use this for portable programs, half-uninstalled programs, or anything not in the Programs list." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox Text="{Binding Folder}" IsReadOnly="True" />
                            <TextBlock Text="Program folder" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                       IsHitTestVisible="False" Visibility="{Binding Folder, Converter={StaticResource NotVis}}" />
                        </Grid>
                        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0" />
                        <Grid Grid.Column="2">
                            <TextBox Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Program name (helps the search)" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                       IsHitTestVisible="False" Visibility="{Binding ProgramName, Converter={StaticResource NotVis}}" />
                        </Grid>
                        <Button Grid.Column="3" Content="Scan &amp; remove" Style="{StaticResource DangerButton}" Command="{Binding ForceFolderCommand}" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Programs that can't be uninstalled normally" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Their uninstaller is missing. Force Uninstall removes the program's files and its entry." Style="{StaticResource Small}" Margin="0,2,0,8" />
                        </StackPanel>
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Text="None found — every program has a working uninstaller." Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Visibility="{Binding BrokenPrograms.Count, Converter={StaticResource NotVis}}" />
                    <ItemsControl ItemsSource="{Binding BrokenPrograms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:InstalledProgram}">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UninstallString}" Style="{StaticResource Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Force uninstall" Style="{StaticResource DangerButton}" VerticalAlignment="Center"
                                            Command="{Binding DataContext.ForceProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
