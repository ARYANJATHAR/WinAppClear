<UserControl x:Class="WinAppClear.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mon="clr-namespace:WinAppClear.Core.Monitor;assembly=WinAppClear.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Recorder -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <!-- Idle -->
                <Grid Visibility="{Binding IsRecording, Converter={StaticResource NotVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Monitor a new installation" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Small}" Margin="0,2,0,12"
                                   Text="1. Name it and (optionally) choose the setup file.   2. WinAppClear records your system.   3. Install as normal.   4. WinAppClear records again and saves the difference." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox Text="{Binding InstallName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Program name" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                           IsHitTestVisible="False" Visibility="{Binding InstallName, Converter={StaticResource NotVis}}" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="8,0">
                                <TextBox Text="{Binding InstallerPath}" IsReadOnly="True" />
                                <TextBlock Text="Setup file (optional)" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                           IsHitTestVisible="False" Visibility="{Binding InstallerPath, Converter={StaticResource NotVis}}" />
                            </Grid>
                            <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseInstallerCommand}" />
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" VerticalAlignment="Bottom"
                            Margin="16,0,0,0" Padding="20,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" FontSize="12" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="Start recording" />
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- Recording -->
                <Grid Visibility="{Binding IsRecording, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="14" Height="14" Fill="{StaticResource DangerBrush}" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding RecordingSince}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Install the program now. When it's done (and you've opened it once if it sets itself up on first run), click Finish recording."
                                   Style="{StaticResource Small}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Discard" Command="{Binding CancelRecordingCommand}" Margin="0,0,8,0" />
                        <Button Content="Finish recording" Style="{StaticResource PrimaryButton}" Command="{Binding FinishCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Logged programs -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Logged programs" Style="{StaticResource SectionTitle}" Margin="16,14,16,8" />
                    <TextBlock DockPanel.Dock="Top" Text="No installs recorded yet." Style="{StaticResource Small}" Margin="16,0,16,8"
                               Visibility="{Binding Logs.Count, Converter={StaticResource NotVis}}" />
                    <ListBox ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type mon:InstallLog}">
                                <StackPanel Margin="8,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Small}">
                                        <Run Text="{Binding Finished, Mode=OneWay, StringFormat=g}" /><Run Text=" · " /><Run Text="{Binding TotalChanges, Mode=OneWay}" /><Run Text=" changes" />
                                    </TextBlock>
                                    <TextBlock Text="Removed" Style="{StaticResource Small}" Foreground="{StaticResource AccentDarkBrush}"
                                               Visibility="{Binding Removed, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <Grid>
                    <TextBlock Text="Select a logged program to review detected installation changes." Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedLog, Converter={StaticResource NotVis}}" />
                    <DockPanel Visibility="{Binding SelectedLog, Converter={StaticResource Vis}}">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedLog.Name}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,260,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Delete log" Command="{Binding DeleteLogCommand}" CommandParameter="{x:Null}" Margin="0,0,8,0" />
                                <Button Content="Uninstall completely" Style="{StaticResource DangerButton}" Command="{Binding UninstallWithLogCommand}" CommandParameter="{x:Null}" />
                            </StackPanel>
                        </Grid>
                        <ListBox ItemsSource="{Binding SelectedDetails}" BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 VirtualizingPanel.IsVirtualizing="True" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
