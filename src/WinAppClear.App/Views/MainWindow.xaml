<Window x:Class="WinAppClear.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinAppClear.App.ViewModels"
        Title="WinAppClear" Width="1280" Height="800" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="/Assets/winappclear.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,14">
                    <Image Source="/Assets/winappclear-512.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinAppClear" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Uninstall cleanly" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,16">
                    <Border Style="{StaticResource Pill}" Background="#3A2A10" Margin="0,0,0,8"
                            Visibility="{Binding IsAdmin, Converter={StaticResource NotVis}}">
                        <TextBlock Text="Not running as administrator — some actions will fail" Foreground="#F5C26B" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavSection}">
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SidebarMutedBrush}"
                                               Margin="22,4,0,3" Visibility="{Binding Title, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Page -->
        <Grid Grid.Column="1" Margin="32,26,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding CurrentPage}" ContentTemplate="{StaticResource PageHeader}" />
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="ShowSectionHelp"
                        VerticalAlignment="Top" Margin="12,0,0,0" Padding="8" Cursor="Help"
                        AutomationProperties.Name="About this section" AutomationProperties.HelpText="{Binding CurrentHelpText}"
                        ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="20000">
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="17" />
                    <Button.ToolTip>
                        <ToolTip Placement="Bottom" StaysOpen="False">
                            <StackPanel MaxWidth="330">
                                <TextBlock Text="{Binding CurrentPage.Title}" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBlock Text="{Binding CurrentHelpText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
            </Grid>
            <Grid Grid.Row="1">
                <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
                <Border DataContext="{Binding CurrentPage}" Style="{StaticResource BusyOverlay}">
                    <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360" MaxWidth="560">
                        <StackPanel>
                            <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                            <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
            <TextBlock Grid.Row="2" Text="{Binding CurrentPage.StatusText}" Style="{StaticResource Small}" Margin="2,10,0,0" />
        </Grid>
    </Grid>
</Window>
