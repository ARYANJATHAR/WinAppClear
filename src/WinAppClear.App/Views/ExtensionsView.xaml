<UserControl x:Class="WinAppClear.App.Views.ExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="10,0,0,0" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" />
                <TextBlock Text="Search extensions" Margin="31,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                           IsHitTestVisible="False" Visibility="{Binding Search, Converter={StaticResource NotVis}}" />
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="Remove selected" Style="{StaticResource DangerButton}" Command="{Binding RemoveCommand}" CommandParameter="{x:Null}" />
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding View}" SelectionMode="Single" RowHeight="58">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Extension" Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Padding="6,0" Visibility="{Binding Enabled, Converter={StaticResource NotVis}}">
                                        <TextBlock Text="Turned off" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Browser" Width="170" SortMemberPath="Browser">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Browser}" Style="{StaticResource CellText}" />
                                <TextBlock Text="{Binding Profile}" Style="{StaticResource Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Access" Width="270">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="0,0,6,0"
                                           Visibility="{Binding BroadAccess, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding Access}" Style="{StaticResource CellMuted}" ToolTip="{Binding Access}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Content="Open in browser"
                                        Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource GhostButton}" ToolTip="Remove (browser must be closed)"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource DangerBrush}" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
