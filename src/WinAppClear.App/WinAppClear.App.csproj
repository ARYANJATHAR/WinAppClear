<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>WinAppClear.App</RootNamespace>
    <AssemblyName>WinAppClear</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\winappclear.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF leaves System.IO out of implicit usings (Path clashes with Shapes.Path); we don't use Shapes. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinAppClear.Core\WinAppClear.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\winappclear.ico" />
    <Resource Include="Assets\winappclear-512.png" />
  </ItemGroup>
</Project>
